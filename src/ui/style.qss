/*
 * Shadcn-inspired Stylesheet for iEEG BrainSense
 *
 * Based on shadcn/ui zinc theme with light mode + dark sidebar.
 * This stylesheet provides consistent styling for all Qt widgets.
 *
 * Usage: Load this file in main.py with app.setStyleSheet()
 *
 * Author: iEEG BrainSense Development Team
 * Last Updated: 2025-10-01
 */

/* ========================================================================
   Global Defaults
   ======================================================================== */

/* No font-family anywhere: the app font is the system UI font (set in
   app_bootstrap.configure_application). Families Qt doesn't know cost an alias
   lookup at startup. This rule is the body size of every widget. */
* {
    font-size: 15px;
}

QWidget {
    background-color: transparent;
    color: #1e293b;
}

/* ========================================================================
   QPushButton - Shadcn Button Variants
   ======================================================================== */

QPushButton {
    background-color: #3353a5;
    color: #ffffff;
    border: none;
    border-radius: 6px;
    padding: 5px 20px;
    font-size: 14px;
    font-weight: 500;
    min-height: 30px;
    max-height: 30px;
}

QPushButton:hover {
    background-color: #2b468c;
}

QPushButton:pressed {
    background-color: #243b75;
}

QPushButton:disabled {
    background-color: #cbd5e1;
    color: #94a3b8;
}

/* Secondary Variant */
QPushButton[variant="secondary"] {
    background-color: #e2e8f0;
    color: #1e293b;
}

QPushButton[variant="secondary"]:hover {
    background-color: #cbd5e1;
}

QPushButton[variant="secondary"]:pressed {
    background-color: #94a3b8;
}

/* Success Variant */
QPushButton[variant="success"] {
    background-color: #7cb842;
    color: #ffffff;
}

QPushButton[variant="success"]:hover {
    background-color: #6a9f38;
}

QPushButton[variant="success"]:pressed {
    background-color: #588530;
}

/* Destructive Variant */
QPushButton[variant="destructive"] {
    background-color: #ef4444;
    color: #ffffff;
}

QPushButton[variant="destructive"]:hover {
    background-color: #dc2626;
}

QPushButton[variant="destructive"]:pressed {
    background-color: #b91c1c;
}

/* Warning Variant */
QPushButton[variant="warning"] {
    background-color: #f59e0b;
    color: #ffffff;
}

QPushButton[variant="warning"]:hover {
    background-color: #d97706;
}

QPushButton[variant="warning"]:pressed {
    background-color: #b45309;
}

/* Outline Variant */
QPushButton[variant="outline"] {
    background-color: transparent;
    color: #1e293b;
    border: 1px solid #cbd5e1;
}

QPushButton[variant="outline"]:hover {
    background-color: #f8fafc;
    border-color: #94a3b8;
}

QPushButton[variant="outline"]:pressed {
    background-color: #f1f5f9;
}

/* Ghost Variant */
QPushButton[variant="ghost"] {
    background-color: transparent;
    color: #1e293b;
}

QPushButton[variant="ghost"]:hover {
    background-color: #f1f5f9;
}

QPushButton[variant="ghost"]:pressed {
    background-color: #e2e8f0;
}

/* ========================================================================
   QLineEdit - Input Fields
   ======================================================================== */

QLineEdit {
    background-color: #ffffff;
    border: 1px solid #cbd5e1;
    border-radius: 6px;
    padding: 5px 16px;
    font-size: 15px;
    color: #1e293b;
    min-height: 30px;
    max-height: 30px;
    selection-background-color: transparent;
}

QLineEdit:hover {
    border-color: #94a3b8;
}

QLineEdit:focus {
    border-color: #3353a5;
    outline: none;
}

QLineEdit:disabled {
    background-color: #f1f5f9;
    color: #cbd5e1;
    border-color: #e2e8f0;
}

QLineEdit::placeholder {
    color: #94a3b8;
    background-color: transparent;
}

/* ========================================================================
   QComboBox - Select Dropdown
   ======================================================================== */

QComboBox {
    background-color: #ffffff;
    border: 1px solid #cbd5e1;
    border-radius: 6px;
    padding: 5px 16px;
    font-size: 15px;
    color: #1e293b;
    min-height: 30px;
    max-height: 30px;
    selection-background-color: transparent;
}

QComboBox:hover {
    border-color: #94a3b8;
}

QComboBox:focus {
    border-color: #3353a5;
}

QComboBox:disabled {
    background-color: #f1f5f9;
    color: #cbd5e1;
}

QComboBox::drop-down {
    border: none;
    width: 24px;
    subcontrol-origin: padding;
    subcontrol-position: center right;
}

/* Chevron is a real SVG asset referenced by absolute path. Qt's QSS engine
   renders neither the web "border-triangle" trick (it draws a filled rectangle,
   not a triangle) nor `data:` URIs, so both require a shipped file. The
   __CHEVRON_URL__ token is substituted with an absolute url("…") in main.py
   because a relative url() in an app-level stylesheet resolves against the CWD. */
QComboBox::down-arrow {
    image: __CHEVRON_URL__;
    width: 12px;
    height: 8px;
}

QComboBox QAbstractItemView {
    background-color: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 6px;
    padding: 4px;
    selection-background-color: #f1f5f9;
    selection-color: #1e293b;
    outline: none;
}

QComboBox QAbstractItemView::item {
    padding: 8px 12px;
    border-radius: 4px;
}

QComboBox QAbstractItemView::item:hover {
    background-color: #f8fafc;
}

QComboBox QAbstractItemView::item:selected {
    background-color: #f1f5f9;
}

/* ========================================================================
   QSpinBox - Number Fields
   ======================================================================== */

/* The value sits next to its steppers rather than at the far end of a wide
   field, and each stepper is 16 px wide (the style's own are ~14×10); a
   spinbox at least 24 px tall gives each half 12 px or more. */
QSpinBox {
    qproperty-alignment: 'AlignRight | AlignVCenter';
}

QSpinBox::up-button,
QSpinBox::down-button {
    width: 16px;
}

/* ========================================================================
   Compact density
   ======================================================================== */

/* Controls in a container whose "density" property is "compact" (a grouping
   panel on a short window) are 12 px shorter: ~28 px with their own padding.
   Content heights, like the 30 px above. */
QWidget[density="compact"] QPushButton,
QWidget[density="compact"] QComboBox,
QWidget[density="compact"] QLineEdit {
    min-height: 18px;
    max-height: 18px;
}

/* ========================================================================
   QTableWidget - Data Tables
   ======================================================================== */

/* Greyscale + minimal: no outer border/radius, no gridlines, grey (not blue)
 * selection, black header text with a single thin underline. Values mirror the
 * Theme.TABLE_* tokens in src/ui/theme.py — keep the two in sync. */
QTableWidget {
    background-color: #ffffff;
    border: none;
    gridline-color: transparent;
    selection-background-color: #e0e0e0;
    selection-color: #000000;
}

QTableWidget::item {
    padding: 12px;
    border: none;
}

QTableWidget::item:hover {
    background-color: #ececec;
}

QHeaderView::section {
    background-color: #ffffff;
    color: #000000;
    padding: 12px;
    border: none;
    border-bottom: 1px solid #e0e0e0;
    font-weight: 600;
    font-size: 14px;
}

QHeaderView::section:hover {
    background-color: #f4f4f4;
}

/* Qt measures header sections in the header's own font, which `*` makes
   15 px; with the sections' size here they're laid out for the text they paint.
   A table with its own section font sets its header's font to match. */
QHeaderView {
    font-size: 14px;
}

/* Alternating row colors */
QTableWidget::item:alternate {
    background-color: #f4f4f4;
}

/* ========================================================================
   QLabel - Text Labels
   ======================================================================== */

QLabel {
    color: #1e293b;
    background-color: transparent;
    border: none;
}

QLabel:focus {
    background-color: transparent;
}

QLabel::selection {
    background-color: transparent;
}

QLabel[styleClass="heading"] {
    font-size: 28px;
    font-weight: 700;
    color: #1e293b;
    background-color: transparent;
}

QLabel[styleClass="subheading"] {
    font-size: 18px;
    font-weight: 600;
    color: #1e293b;
    background-color: transparent;
}

QLabel[styleClass="muted"] {
    color: #64748b;
    background-color: transparent;
}

QLabel[styleClass="small"] {
    font-size: 13px;
    color: #64748b;
    background-color: transparent;
}

/* ========================================================================
   QFrame - Cards and Containers
   ======================================================================== */

QFrame[styleClass="card"] {
    background-color: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    padding: 24px;
}

QFrame[styleClass="card-hover"]:hover {
    box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
}

/* ========================================================================
   QCheckBox - Checkboxes
   ======================================================================== */

QCheckBox {
    spacing: 8px;
    color: #1e293b;
}

QCheckBox::indicator {
    width: 18px;
    height: 18px;
    border: 1px solid #cbd5e1;
    border-radius: 4px;
    background-color: #ffffff;
}

QCheckBox::indicator:hover {
    border-color: #3353a5;
}

QCheckBox::indicator:checked {
    background-color: #3353a5;
    border-color: #3353a5;
    image: url(none);
}

QCheckBox::indicator:checked:hover {
    background-color: #2b468c;
}

QCheckBox::indicator:disabled {
    background-color: #f1f5f9;
    border-color: #e2e8f0;
}

/* ========================================================================
   QRadioButton - Radio Buttons
   ======================================================================== */

QRadioButton {
    spacing: 8px;
    color: #1e293b;
}

QRadioButton::indicator {
    width: 18px;
    height: 18px;
    border: 1px solid #cbd5e1;
    border-radius: 9px;
    background-color: #ffffff;
}

QRadioButton::indicator:hover {
    border-color: #3353a5;
}

QRadioButton::indicator:checked {
    background-color: #3353a5;
    border-color: #3353a5;
}

QRadioButton::indicator:checked:hover {
    background-color: #2b468c;
}

/* ========================================================================
   QScrollBar - Scrollbars
   ======================================================================== */

QScrollBar:vertical {
    background-color: #f8fafc;
    width: 8px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background-color: #cbd5e1;
    border-radius: 4px;
    min-height: 30px;
}

QScrollBar::handle:vertical:hover {
    background-color: #94a3b8;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar:horizontal {
    background-color: #f8fafc;
    height: 8px;
    margin: 0;
}

QScrollBar::handle:horizontal {
    background-color: #cbd5e1;
    border-radius: 4px;
    min-width: 30px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #94a3b8;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0;
}

/* Tables scroll inside themselves, sideways too: thicker bars that are easier
   to grab (Dim.TABLE_SCROLLBAR). */
QTableView QScrollBar:vertical {
    width: 10px;
}

QTableView QScrollBar:horizontal {
    height: 10px;
}

/* ========================================================================
   Dialogs (QMessageBox / QInputDialog / QFileDialog) - greyscale theme

   Buttons here would otherwise inherit the blue base QPushButton; override
   them with the manuscript greyscale tier (matches the Upload button). The
   coloured severity *icons* in QMessageBox can't be themed via QSS - those are
   greyscaled by GreyscaleProxyStyle (installed in main.py).
   ======================================================================== */

QMessageBox,
QInputDialog,
QFileDialog {
    background-color: #ffffff;
}

QMessageBox QLabel,
QInputDialog QLabel,
QFileDialog QLabel {
    color: #1e293b;
}

QMessageBox QPushButton,
QInputDialog QPushButton,
QFileDialog QPushButton {
    background-color: #555555;
    color: #ffffff;
    border: none;
    border-radius: 6px;
    padding: 5px 18px;
    min-width: 80px;
}

QMessageBox QPushButton:hover,
QInputDialog QPushButton:hover,
QFileDialog QPushButton:hover {
    background-color: #454545;
}

QMessageBox QPushButton:pressed,
QInputDialog QPushButton:pressed,
QFileDialog QPushButton:pressed {
    background-color: #363636;
}

QMessageBox QPushButton:disabled,
QInputDialog QPushButton:disabled,
QFileDialog QPushButton:disabled {
    background-color: #cbd5e1;
    color: #ffffff;
}

/* QFileDialog inner controls - replace the blue accents with greys */
QFileDialog QListView,
QFileDialog QTreeView {
    background-color: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 6px;
}

QFileDialog QListView::item:selected,
QFileDialog QTreeView::item:selected,
QFileDialog QListView::item:selected:active,
QFileDialog QTreeView::item:selected:active,
QFileDialog QListView::item:selected:!active,
QFileDialog QTreeView::item:selected:!active {
    background-color: #555555;
    color: #ffffff;
}

QFileDialog QLineEdit,
QFileDialog QComboBox {
    background-color: #ffffff;
    color: #1e293b;
    border: 1px solid #cbd5e1;
    border-radius: 6px;
    padding: 4px 8px;
}

QFileDialog QLineEdit:focus,
QFileDialog QComboBox:focus {
    border-color: #555555;
}

QFileDialog QToolButton {
    background-color: transparent;
    border-radius: 4px;
    padding: 2px;
}

QFileDialog QToolButton:hover {
    background-color: #f1f5f9;
}

QFileDialog QToolButton:pressed {
    background-color: #e2e8f0;
}

/* ========================================================================
   QStackedWidget - Page Containers
   ======================================================================== */

QStackedWidget {
    background-color: #f8fafc;
}

/* ========================================================================
   QMenuBar and QMenu - Menus
   ======================================================================== */

QMenuBar {
    background-color: #ffffff;
    border-bottom: 1px solid #e2e8f0;
}

QMenuBar::item {
    padding: 8px 16px;
    background-color: transparent;
    color: #1e293b;
}

QMenuBar::item:selected {
    background-color: #f1f5f9;
}

QMenu {
    background-color: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    padding: 4px;
}

QMenu::item {
    padding: 8px 16px;
    border-radius: 4px;
}

QMenu::item:selected {
    background-color: #f1f5f9;
}

/* ========================================================================
   Restart banner - interface-size notice under the top bar
   (src/ui/components/restart_banner.py)
   ======================================================================== */

QFrame#restart_banner {
    background-color: #f1f5f9;
    border: none;
    border-bottom: 1px solid #e2e8f0;
}

QLabel#restart_banner_message {
    font-size: 14px;
}

/* The primary action in the top bar's primary grey, like Upload */
QPushButton#restart_banner_primary {
    background-color: #555555;
}

QPushButton#restart_banner_primary:hover {
    background-color: #454545;
}

QPushButton#restart_banner_primary:pressed {
    background-color: #363636;
}

/* ========================================================================
   QToolTip - Tooltips
   ======================================================================== */

QToolTip {
    background-color: #1e293b;
    color: #ffffff;
    border: none;
    border-radius: 6px;
    padding: 8px 12px;
    font-size: 13px;
}
